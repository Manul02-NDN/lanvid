# LanVid Monitor - App Store / TestFlight automation.
#
#   bundle exec fastlane beta                              build a signed .ipa and upload to TestFlight
#   bundle exec fastlane publish_existing_build            attach latest TestFlight build, upload metadata/screenshots & submit
#   bundle exec fastlane release                           build + upload .ipa, screenshots & metadata to App Store Connect
#   bundle exec fastlane release skip_build:true submit:true  attach latest TestFlight build & submit without rebuilding
#   bundle exec fastlane metadata                          metadata + screenshots only (no new binary)

require "base64"
require "fileutils"
require "shellwords"
require "tmpdir"

default_platform(:ios)

BUNDLE_ID = (ENV["APP_IDENTIFIER"] || "com.manul02.lanvid.monitor").freeze
SCHEME = "LanVidMonitor".freeze
PROJECT = "LanVidMonitor.xcodeproj".freeze

platform :ios do
  def require_env!(*names)
    missing = names.select { |n| ENV[n].nil? || ENV[n].strip.empty? }
    return if missing.empty?
    UI.user_error!("Missing #{missing.join(', ')}. Add them as GitHub Secrets / environment variables " \
                   "(see mobile/ios/APPSTORE_SETUP.md).")
  end

  def api_key_path
    return ENV["APP_STORE_CONNECT_API_KEY_PATH"] if ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s != ""
    require_env!("APP_STORE_CONNECT_API_KEY_BASE64")
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s.strip
    path = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
    raw_secret = ENV["APP_STORE_CONNECT_API_KEY_BASE64"].to_s.strip
    if raw_secret.include?("-----BEGIN")
      pem = raw_secret.gsub("\r\n", "\n").gsub("\r", "\n").strip + "\n"
    else
      decoded = Base64.decode64(raw_secret.gsub(/\s+/, ""))
      if decoded.include?("-----BEGIN")
        pem = decoded.sub(/\A\xEF\xBB\xBF/, "").gsub("\r\n", "\n").gsub("\r", "\n").strip + "\n"
      else
        b64 = Base64.strict_encode64(decoded).scan(/.{1,64}/).join("\n")
        pem = "-----BEGIN PRIVATE KEY-----\n#{b64}\n-----END PRIVATE KEY-----\n"
      end
    end
    File.write(path, pem)
    File.chmod(0o600, path)
    path
  end

  def connect_api_key
    require_env!("APP_STORE_CONNECT_API_KEY_ID", "APP_STORE_CONNECT_ISSUER_ID")
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s.strip,
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip,
      key_filepath: api_key_path,
      in_house: false
    )
  end

  def resolve_team_id
    team = ENV["TEAM_ID"].to_s.strip
    return team unless team.empty?
    begin
      bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
      if bundle.nil?
        UI.message("Registering bundle ID #{BUNDLE_ID}")
        bundle = Spaceship::ConnectAPI::BundleId.create(name: "LanVid Monitor", platform: "IOS", identifier: BUNDLE_ID)
      end
      team = bundle.seed_id.to_s
    rescue StandardError => e
      UI.important("Could not read the team ID from App Store Connect: #{e.message}")
    end
    UI.user_error!("Team ID unknown. Set TEAM_ID / GitHub Secret APPLE_TEAM_ID.") if team.empty?
    team
  end

  def build_number
    (ENV["GITHUB_RUN_NUMBER"] || ENV["BUILD_NUMBER"] || Time.now.strftime("%y%m%d%H%M")).to_s
  end

  def fastlane_dir
    cand = File.expand_path("fastlane", Dir.pwd)
    File.directory?(cand) ? cand : File.expand_path(__dir__)
  end

  def valid_contact_value?(val)
    s = val.to_s.strip
    !s.empty? && !s.start_with?("FILL_IN")
  end

  def find_latest_testflight_build(expected_build: nil, max_attempts: 20)
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    if app.nil?
      available = Spaceship::ConnectAPI::App.all.map { |a| "#{a.bundle_id} (#{a.name})" }.join(", ")
      UI.user_error!("App record #{BUNDLE_ID} not found in App Store Connect. Available apps: #{available}")
    end

    explicit_build = (expected_build || ENV["BUILD_NUMBER"]).to_s.strip
    max_attempts.times do |attempt|
      builds = app.get_builds(
        includes: "preReleaseVersion",
        sort: "-uploadedDate",
        limit: 10
      )
      UI.message("App Store Connect builds for #{BUNDLE_ID} (count=#{builds.length}): " +
                 builds.map { |b| "#{b.version}[state=#{b.processing_state},expired=#{b.expired},ver=#{b.pre_release_version&.version}]" }.join(", "))

      active_builds = builds.reject(&:expired)
      valid_builds = active_builds.select { |b| b.processing_state == "VALID" }
      chosen = explicit_build.empty? ? valid_builds.first : valid_builds.find { |b| b.version.to_s == explicit_build }
      if chosen
        app_ver = chosen.pre_release_version&.version.to_s
        UI.success("Selected existing TestFlight build #{chosen.version} (id=#{chosen.id}, app version: #{app_ver.empty? ? 'default' : app_ver})")
        return { build_id: chosen.id, build_number: chosen.version.to_s, app_version: app_ver.empty? ? nil : app_ver }
      end

      processing = if explicit_build.empty?
                     active_builds.find { |b| b.processing_state == "PROCESSING" }
                   else
                     active_builds.find { |b| b.version.to_s == explicit_build && b.processing_state == "PROCESSING" }
                   end
      waiting_for_expected = !explicit_build.empty? && active_builds.none? { |b| b.version.to_s == explicit_build }
      if (processing || waiting_for_expected) && attempt < max_attempts - 1
        reason = processing ? "build #{processing.version} is still PROCESSING" : "waiting for build #{explicit_build} to appear in App Store Connect"
        UI.message("#{reason} (attempt #{attempt + 1}/#{max_attempts}); waiting 15s...")
        sleep(15)
        next
      end

      break
    end

    nil
  end

  def attach_build_to_edit_version(build_id:, build_number: nil)
    return if build_id.to_s.empty?
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    return if app.nil?
    edit_ver = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    return if edit_ver.nil?
    edit_ver.select_build(build_id: build_id)
    UI.success("Attached build #{build_number || build_id} to App Store version #{edit_ver.version_string} (state=#{edit_ver.app_store_state})")
  rescue StandardError => e
    UI.important("Could not attach build #{build_number || build_id} to App Store version: #{e.message}")
  end

  def log_app_store_version_status
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    return if app.nil?
    versions = app.get_app_store_versions(filter: { platform: "IOS" }, includes: "build")
    versions.first(3).each do |v|
      UI.message("App Store version #{v.version_string}: state=#{v.app_store_state}, build=#{v.build&.version || 'none'}")
    end
  rescue StandardError => e
    UI.message("Could not read App Store version status: #{e.message}")
  end

  def resolve_review_information
    dir = File.join(fastlane_dir, "metadata", "review_information")
    read_local = lambda do |file, env|
      v = ENV[env].to_s.strip
      v = File.read(File.join(dir, file)).strip if v.empty? && File.exist?(File.join(dir, file))
      valid_contact_value?(v) ? v : ""
    end

    info = {
      first_name: read_local.call("first_name.txt", "REVIEW_FIRST_NAME"),
      last_name: read_local.call("last_name.txt", "REVIEW_LAST_NAME"),
      email_address: read_local.call("email_address.txt", "REVIEW_EMAIL"),
      phone_number: read_local.call("phone_number.txt", "REVIEW_PHONE"),
      demo_user: "",
      demo_password: "",
      notes: read_local.call("notes.txt", "REVIEW_NOTES")
    }

    missing_keys = [:first_name, :last_name, :email_address, :phone_number].select { |k| info[k].empty? }
    unless missing_keys.empty?
      begin
        app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
        if app
          sources = []
          begin
            edit_ver = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
            sources << edit_ver.fetch_app_store_review_detail if edit_ver
          rescue StandardError => e
            UI.message("Could not read appStoreReviewDetail: #{e.message}")
          end
          begin
            if defined?(Spaceship::ConnectAPI::BetaAppReviewDetail) && Spaceship::ConnectAPI::BetaAppReviewDetail.respond_to?(:find)
              sources << Spaceship::ConnectAPI::BetaAppReviewDetail.find(app_id: app.id)
            end
          rescue StandardError => e
            UI.message("Could not read betaAppReviewDetail: #{e.message}")
          end
          sources.compact.each do |src|
            info[:first_name] = src.contact_first_name.to_s.strip if info[:first_name].empty? && valid_contact_value?(src.contact_first_name)
            info[:last_name] = src.contact_last_name.to_s.strip if info[:last_name].empty? && valid_contact_value?(src.contact_last_name)
            info[:email_address] = src.contact_email.to_s.strip if info[:email_address].empty? && valid_contact_value?(src.contact_email)
            info[:phone_number] = src.contact_phone.to_s.strip if info[:phone_number].empty? && valid_contact_value?(src.contact_phone)
          end
        end
        if info[:first_name].empty? || info[:last_name].empty? || info[:email_address].empty?
          users = Spaceship::ConnectAPI::User.all
          admin = users.find { |u| Array(u.roles).include?("ADMIN") || Array(u.roles).include?("ACCOUNT_HOLDER") } || users.first
          if admin
            info[:first_name] = admin.first_name.to_s.strip if info[:first_name].empty? && valid_contact_value?(admin.first_name)
            info[:last_name] = admin.last_name.to_s.strip if info[:last_name].empty? && valid_contact_value?(admin.last_name)
            info[:email_address] = admin.username.to_s.strip if info[:email_address].empty? && valid_contact_value?(admin.username)
          end
        end
      rescue StandardError => e
        UI.important("Could not auto-fill review contact from App Store Connect: #{e.message}")
      end
    end

    info
  end

  def with_sanitized_metadata_dir(skip_review_info: false)
    src = File.join(fastlane_dir, "metadata")
    Dir.mktmpdir("lanvid_deliver_meta") do |tmp|
      dst = File.join(tmp, "metadata")
      FileUtils.cp_r(src, dst)
      review_dir = File.join(dst, "review_information")
      if skip_review_info
        FileUtils.rm_rf(review_dir)
      else
        %w[first_name.txt last_name.txt email_address.txt phone_number.txt].each do |fname|
          path = File.join(review_dir, fname)
          next unless File.exist?(path)
          content = File.read(path).strip
          File.delete(path) unless valid_contact_value?(content)
        end
      end
      yield dst
    end
  end

  desc "Build a signed App Store .ipa (manual App Store Distribution signing via App Store Connect API key — works even with 0 registered devices)"
  lane :build_ipa do
    ci_keychain = nil
    if ENV["CI"].to_s == "true"
      setup_ci
      ci_keychain = [
        File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db"),
        File.expand_path("~/Library/Keychains/fastlane_tmp_keychain")
      ].find { |p| File.exist?(p) }
    end

    key = connect_api_key
    team = resolve_team_id

    FileUtils.mkdir_p("build/certs")
    FileUtils.mkdir_p("build/profiles")

    cert_opts = {
      api_key: key,
      team_id: team,
      development: false,
      generate_apple_certs: true,
      output_path: "build/certs"
    }
    if ci_keychain
      cert_opts[:keychain_path] = ci_keychain
      cert_opts[:keychain_password] = ""
    end
    get_certificates(**cert_opts)
    cert_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]

    if ci_keychain
      sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k '' #{Shellwords.escape(ci_keychain)} >/dev/null")
    end
    sh("security find-identity -v -p codesigning")

    profile_path = get_provisioning_profile(
      api_key: key,
      team_id: team,
      app_identifier: BUNDLE_ID,
      cert_id: cert_id,
      force: true,
      output_path: "build/profiles"
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_uuid = lane_context[SharedValues::SIGH_UUID]
    UI.success("Using App Store Distribution profile '#{profile_name}' (UUID=#{profile_uuid}, cert=#{cert_id})")

    [
      File.expand_path("~/Library/MobileDevice/Provisioning Profiles"),
      File.expand_path("~/Library/Developer/Xcode/UserData/Provisioning Profiles")
    ].each do |dir|
      FileUtils.mkdir_p(dir)
      if profile_path && File.exist?(profile_path)
        FileUtils.cp(profile_path, File.join(dir, "#{profile_uuid}.mobileprovision"))
      end
    end

    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: team,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      profile_uuid: profile_uuid
    )

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      output_directory: "build/ipa",
      output_name: "LanVidMonitor.ipa",
      export_method: "app-store",
      export_team_id: team,
      export_options: {
        signingStyle: "manual",
        teamID: team,
        signingCertificate: "Apple Distribution",
        provisioningProfiles: { BUNDLE_ID => profile_name },
        manageAppVersionAndBuildNumber: false
      },
      xcargs: [
        "DEVELOPMENT_TEAM=#{team}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=#{Shellwords.escape('Apple Distribution')}",
        "PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile_name)}",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" ")
    )
    key
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    key = build_ipa
    notes = File.join(fastlane_dir, "metadata", "en-US", "release_notes.txt")
    upload_to_testflight(
      api_key: key,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      changelog: File.exist?(notes) ? File.read(notes) : nil,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Attach latest existing TestFlight build, upload metadata & screenshots, and optionally submit for App Review"
  lane :publish_existing_build do |options|
    submit = options.key?(:submit) ? options[:submit].to_s == "true" : (ENV["SUBMIT_FOR_REVIEW"].to_s != "false")
    key = connect_api_key
    tf = find_latest_testflight_build
    if tf.nil?
      UI.important("No VALID TestFlight build found yet for #{BUNDLE_ID}. Uploading all metadata, screenshots & age rating now (without submitting).")
      deliver_to_store(key, nil, false)
      UI.user_error!("Metadata & screenshots uploaded for #{BUNDLE_ID}, but no VALID TestFlight build exists yet in App Store Connect. Run with skip_build=false to build & upload the .ipa.")
    else
      deliver_to_store(key, nil, submit, build_id: tf[:build_id], build_number: tf[:build_number], app_version: tf[:app_version])
    end
  end

  desc "Upload build (or existing TestFlight build with skip_build:true), screenshots and metadata to App Store Connect"
  lane :release do |options|
    submit = options[:submit].to_s == "true" || ENV["SUBMIT_FOR_REVIEW"].to_s == "true"
    skip_build = options[:skip_build].to_s == "true" || ENV["SKIP_BUILD"].to_s == "true"
    if skip_build
      publish_existing_build(submit: submit)
    else
      key = build_ipa
      deliver_to_store(key, lane_context[SharedValues::IPA_OUTPUT_PATH], submit, build_number: build_number)
    end
  end

  desc "Upload only screenshots and metadata (no new binary)"
  lane :metadata do |options|
    submit = options[:submit].to_s == "true"
    deliver_to_store(connect_api_key, nil, submit)
  end

  def deliver_to_store(key, ipa, submit, build_id: nil, build_number: nil, app_version: nil)
    info = resolve_review_information
    missing_contact = [:first_name, :last_name, :email_address, :phone_number].select { |k| info[k].empty? }
    can_submit = submit && missing_contact.empty?
    if submit && !missing_contact.empty?
      UI.important("App Review contact fields missing (#{missing_contact.join(', ')}). " \
                   "Uploading metadata, screenshots and attaching build first (submit_for_review deferred until contact is provided).")
    end

    skip_review_info = !missing_contact.empty?
    if skip_review_info
      require "deliver/upload_metadata"
      unless Deliver::UploadMetadata.instance_variable_defined?(:@lanvid_review_attachment_patched)
        patch = Module.new do
          def review_attachment_file(*args, **kwargs)
            super
          rescue RuntimeError => e
            raise unless e.message.to_s.include?("No data")
            FastlaneCore::UI.important("Skipping review_attachment_file sync (first version has no appStoreReviewDetail yet).")
          end
        end
        Deliver::UploadMetadata.prepend(patch)
        Deliver::UploadMetadata.instance_variable_set(:@lanvid_review_attachment_patched, true)
      end
    end
    with_sanitized_metadata_dir(skip_review_info: skip_review_info) do |meta_dir|
      opts = {
        api_key: key,
        skip_binary_upload: ipa.nil?,
        metadata_path: meta_dir,
        screenshots_path: File.join(fastlane_dir, "screenshots"),
        app_rating_config_path: File.join(fastlane_dir, "age_rating.json"),
        submission_information: {
          export_compliance_uses_encryption: false,
          add_id_info_uses_idfa: false
        },
        languages: %w[en-US uk],
        overwrite_screenshots: true,
        force: true,
        precheck_include_in_app_purchases: false,
        run_precheck_before_submit: false,
        automatic_release: true,
        submit_for_review: can_submit,
        reject_if_possible: false
      }
      opts[:app_review_information] = info unless skip_review_info
      opts[:ipa] = ipa unless ipa.nil?
      opts[:build_number] = build_number unless build_number.to_s.empty? || !ipa.nil?
      opts[:app_version] = app_version unless app_version.to_s.empty?
      upload_to_app_store(**opts)
    end

    if !can_submit
      if !build_id.to_s.empty?
        attach_build_to_edit_version(build_id: build_id, build_number: build_number)
      elsif !ipa.nil?
        UI.message("Waiting for newly uploaded build #{build_number} to finish processing so we can attach it to the App Store version...")
        tf = find_latest_testflight_build(expected_build: build_number, max_attempts: 48)
        attach_build_to_edit_version(build_id: tf[:build_id], build_number: tf[:build_number]) if tf
      end
    end

    log_app_store_version_status

    if submit && !missing_contact.empty?
      UI.user_error!("Metadata, screenshots & build #{build_number} were uploaded and attached, " \
                     "but final submission needs App Review contact (#{missing_contact.join(', ')}). " \
                     "Add REVIEW_FIRST_NAME / REVIEW_LAST_NAME / REVIEW_EMAIL / REVIEW_PHONE in GitHub Secrets or App Store Connect.")
    end
  end
end
