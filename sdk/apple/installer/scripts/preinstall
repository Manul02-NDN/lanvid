#!/usr/bin/env bash
# LanVidSDK macOS Installer — preinstall script
# Runs as root via macOS Installer.app before payload extraction.
# Checks architecture, macOS version (>= 12.0), active dylib/UDP conflicts, Xcode CLT,
# and cleans previous /usr/local/LanVidSDK installations for an atomic upgrade.

set -euo pipefail

LOG_FILE="/var/log/lanvid_sdk_install.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "=== [LanVidSDK preinstall] $(date -u '+%Y-%m-%dT%H:%M:%SZ') ==="

# Determine real logged-in desktop user (Installer runs as root)
CONSOLE_USER="$(stat -f "%Su" /dev/console 2>/dev/null || echo "${USER:-root}")"
if [ "$CONSOLE_USER" = "loginwindow" ] || [ -z "$CONSOLE_USER" ]; then
  CONSOLE_USER="root"
fi

# 1. Detect CPU architecture & macOS version (>= 12.0 Monterey required)
ARCH="$(uname -m)"
MACOS_VER="$(sw_vers -productVersion 2>/dev/null || echo "0.0")"
MACOS_MAJOR="${MACOS_VER%%.*}"
echo "[INFO] Host architecture: $ARCH | macOS version: $MACOS_VER | Console user: $CONSOLE_USER"

case "$ARCH" in
  arm64)  echo "[OK] Apple Silicon detected (ARM64 NEON acceleration enabled)." ;;
  x86_64) echo "[OK] Intel Mac detected (x86_64 AVX2 runtime dispatch enabled)." ;;
  *)      echo "[WARN] Unrecognized architecture '$ARCH'; continuing anyway." ;;
esac

if [ "${MACOS_MAJOR:-0}" -lt 12 ] 2>/dev/null; then
  echo "[ERROR] LanVidSDK requires macOS 12.0 (Monterey) or newer. Detected: $MACOS_VER"
  if [ "$CONSOLE_USER" != "root" ] && [ -z "${CI:-}" ]; then
    sudo -u "$CONSOLE_USER" osascript -e \
      "display dialog \"LanVidSDK вимагає macOS 12.0 або новішої версії (виявлено $MACOS_VER).\n\nLanVidSDK requires macOS 12.0 or later.\" buttons {\"OK\"} default button \"OK\" with icon stop with title \"LanVidSDK Installer\"" \
      >/dev/null 2>&1 || true
  fi
  exit 1
fi

# 2. Check processes holding an older liblanvid_core.dylib or occupying UDP 5000 / 5099
if command -v lsof >/dev/null 2>&1; then
  if [ -f "/usr/local/LanVidSDK/lib/liblanvid_core.dylib" ]; then
    DYLIB_USERS="$(lsof -t "/usr/local/LanVidSDK/lib/liblanvid_core.dylib" 2>/dev/null || true)"
    if [ -n "$DYLIB_USERS" ]; then
      echo "[WARN] Processes currently using previous liblanvid_core.dylib (PIDs: $DYLIB_USERS)"
      for pid in $DYLIB_USERS; do
        pname="$(ps -p "$pid" -o comm= 2>/dev/null || echo "unknown")"
        echo "       -> PID $pid ($pname)"
      done
    fi
  fi

  for udp_port in 5000 5099; do
    PORT_INFO="$(lsof -nP -iUDP:"$udp_port" 2>/dev/null | tail -n +2 || true)"
    if [ -n "$PORT_INFO" ]; then
      echo "[WARN] UDP port $udp_port is currently in use:"
      echo "$PORT_INFO"
      if [ "$udp_port" -eq 5000 ] && [ "$CONSOLE_USER" != "root" ]; then
        USER_HOME="$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}' || echo "")"
        if [ -n "$USER_HOME" ] && [ -d "$USER_HOME" ]; then
          CFG_DIR="$USER_HOME/.config/lanvid"
          mkdir -p "$CFG_DIR"
          ALT_PORT=5002
          for cand in 5002 5004 5006 5008 5010; do
            if ! lsof -nP -iUDP:"$cand" >/dev/null 2>&1; then
              ALT_PORT="$cand"
              break
            fi
          done
          echo "[INFO] Port 5000 busy -> recording suggested free port $ALT_PORT in $CFG_DIR/sdk_ports.json"
          printf '{"default_udp_port": %d, "port_5000_conflict": true}\n' "$ALT_PORT" > "$CFG_DIR/sdk_ports.json"
          chown -R "$CONSOLE_USER":staff "$CFG_DIR" 2>/dev/null || true
        fi
      fi
    else
      echo "[OK] UDP port $udp_port is free."
    fi
  done
fi

# 3. Check Xcode Command Line Tools (required for clang / Swift / Xcode integration)
if xcode-select -p >/dev/null 2>&1; then
  echo "[OK] Xcode Command Line Tools found at: $(xcode-select -p)"
else
  echo "[WARN] Xcode Command Line Tools are not installed."
  if [ "$CONSOLE_USER" != "root" ] && [ -z "${CI:-}" ]; then
    sudo -u "$CONSOLE_USER" osascript -e \
      'display dialog "Не знайдено Xcode Command Line Tools.\n\nЗараз буде запущено стандартне вікно Apple для їх встановлення. Встановлення LanVidSDK продовжиться автоматично.\n\nXcode Command Line Tools were not found and will now be requested." buttons {"OK"} default button "OK" with icon note with title "LanVidSDK Installer"' \
      >/dev/null 2>&1 || true
    sudo -u "$CONSOLE_USER" xcode-select --install >/dev/null 2>&1 || true
  fi
fi

# 4. Clean previous SDK installation for a crisp upgrade
if [ -d "/usr/local/LanVidSDK" ]; then
  echo "[INFO] Removing previous /usr/local/LanVidSDK before clean install..."
  rm -rf "/usr/local/LanVidSDK"
fi

echo "=== [LanVidSDK preinstall] Complete ==="
exit 0
