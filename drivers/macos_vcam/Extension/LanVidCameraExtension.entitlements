<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<!-- Mach service of the extension (must be inside an app group) -->
		<string>$(TeamIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<!-- Short group for the LanVidVideoBus_v1 POSIX shared memory (macOS shm names are <= 31 chars) -->
		<string>$(LANVID_APP_GROUP)</string>
	</array>
</dict>
</plist>
